root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{json,yaml,yml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[{Makefile,makefile,*.mk}]
indent_style = tab
indent_size = tab
tab_width = 4

# Do not impose team formatting on the SDK and build outputs.
[{include/pros/**,include/liblvgl/**,include/api.h,firmware/**,bin/**,.d/**,.cache/**}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
indent_style = unset
indent_size = unset
