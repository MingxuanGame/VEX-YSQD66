#pragma once

#include <array>
#include <cstdint>

namespace chassis {

/**
 * @file chassis.h
 * @brief 四轮独立麦轮底盘的参考公共接口。
 *
 * 轮序固定：FL / FR / BL / BR。
 * 速度是轮端 RPM，位置是轮端角度，功率是 -127..127。
 * 电机端 RPM = 轮端 RPM * motor_to_wheel_ratio。
 */
enum class Wheel : std::uint8_t { FrontLeft = 0, FrontRight = 1, BackLeft = 2, BackRight = 3 };
enum class Gearset : std::uint8_t { Red, Green, Blue };
enum class Mode : std::uint8_t { Stopped, Power, Velocity, Fault };
enum class Fault : std::uint8_t {
    None,
    NotInitialized,
    InvalidConfig,
    PortConflict,
    WriteFailed,
    OverCurrent,
    OverTemperature,
    StaleCommand
};

struct WheelConfig {
    int port = 1; // 负号表示反转；必须是 1..21 的绝对值
    double max_current_ma = 2500.0;
    double max_temperature_c = 55.0;
};

struct Config {
    std::array<WheelConfig, 4> wheels{
        WheelConfig{1, 2500.0, 55.0},
        WheelConfig{-2, 2500.0, 55.0},
        WheelConfig{3, 2500.0, 55.0},
        WheelConfig{-4, 2500.0, 55.0},
    };
    Gearset gearset = Gearset::Blue;
    double motor_to_wheel_ratio = 9.0; // 电机轴转数 / 轮端转数
    double max_wheel_rpm = 200.0;
    int max_power_delta_per_update = 20; // <=0 关闭功率斜率
    std::uint32_t command_timeout_ms = 100;
    bool tare_on_init = true;
};

struct WheelState {
    double current_ma = 0.0;
    double velocity_rpm = 0.0; // 轮端 RPM
    double position_deg = 0.0; // 轮端角度
    double temperature_c = 0.0;
    bool valid = false;
};

struct State {
    std::array<WheelState, 4> wheel{};
    std::uint32_t timestamp_ms = 0;
    bool valid = false;
};

// 只能成功初始化一次；返回 false 时不要继续驱动。
bool initialize(const Config &config, std::uint32_t now_ms);

bool set_wheel_power(int front_left, int front_right, int back_left, int back_right);
bool set_wheel_velocity(double front_left_rpm, double front_right_rpm, double back_left_rpm,
                       double back_right_rpm);

bool read_state(State &out);

// 只有在 Stopped 状态才允许，避免运动中清编码器。
bool tare_position(std::uint32_t now_ms);

// 周期调用：命令超时、过流/过温会转 Fault 并停止。建议 20ms 一次。
void poll(std::uint32_t now_ms);

// 显式清除 Fault，重新读一次反馈；硬件仍异常时会再次进入 Fault。
bool clearFault(std::uint32_t now_ms);

void stop();

bool isHealthy();
Fault getFault();
const char *faultName(Fault fault);
Mode getMode();

} // namespace chassis
