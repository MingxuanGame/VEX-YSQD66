#include "chassis.h"

#include "pros/misc.hpp"
#include "pros/motors.hpp"

#include <algorithm>
#include <cmath>
#include <cstdint>
#include <limits>
#include <new>

namespace chassis {
namespace {

constexpr int kMinPort = 1;
constexpr int kMaxPort = 21;
constexpr std::uint32_t kMaxCommandAgeMs = 5000;

pros::MotorGears toGearset(Gearset gearset) {
    switch (gearset) {
    case Gearset::Red:
        return pros::MotorGears::red;
    case Gearset::Green:
        return pros::MotorGears::green;
    case Gearset::Blue:
    default:
        return pros::MotorGears::blue;
    }
}

struct MotorBank {
    pros::Motor front_left;
    pros::Motor front_right;
    pros::Motor back_left;
    pros::Motor back_right;

    explicit MotorBank(const Config &config)
        : front_left(config.wheels[0].port, toGearset(config.gearset),
                     pros::MotorUnits::degrees),
          front_right(config.wheels[1].port, toGearset(config.gearset),
                      pros::MotorUnits::degrees),
          back_left(config.wheels[2].port, toGearset(config.gearset),
                    pros::MotorUnits::degrees),
          back_right(config.wheels[3].port, toGearset(config.gearset),
                     pros::MotorUnits::degrees) {}
};

Config g_config{};
alignas(MotorBank) unsigned char g_storage[sizeof(MotorBank)];
MotorBank *g_bank = nullptr;
Mode g_mode = Mode::Stopped;
Fault g_fault = Fault::NotInitialized;
std::uint32_t g_last_command_ms = 0;
std::array<int, 4> g_last_power{};

bool writeFailed(std::int32_t value) {
    return value == std::numeric_limits<std::int32_t>::max();
}

bool forbidden() {
    return pros::competition::is_disabled() || pros::competition::is_autonomous();
}

pros::Motor *motorAt(int wheel) {
    if (!g_bank)
        return nullptr;
    switch (wheel) {
    case 0:
        return &g_bank->front_left;
    case 1:
        return &g_bank->front_right;
    case 2:
        return &g_bank->back_left;
    case 3:
        return &g_bank->back_right;
    default:
        return nullptr;
    }
}

void setFault(Fault fault) {
    g_fault = fault;
    g_mode = Mode::Fault;
    if (g_bank) {
        for (int i = 0; i < 4; ++i) {
            pros::Motor *motor = motorAt(i);
            if (motor)
                motor->move_voltage(0);
        }
        for (int i = 0; i < 4; ++i) {
            pros::Motor *motor = motorAt(i);
            if (motor)
                motor->brake();
        }
    }
    g_last_power.fill(0);
}

void stopAll() {
    if (!g_bank)
        return;
    for (int i = 0; i < 4; ++i) {
        pros::Motor *motor = motorAt(i);
        if (motor)
            motor->move_voltage(0);
    }
    for (int i = 0; i < 4; ++i) {
        pros::Motor *motor = motorAt(i);
        if (motor)
            motor->brake();
    }
    g_last_power.fill(0);
    g_mode = Mode::Stopped;
}

bool validPort(int port) {
    const int value = (port < 0) ? -port : port;
    return value >= kMinPort && value <= kMaxPort;
}

bool validateConfig(const Config &config) {
    if (!std::isfinite(config.motor_to_wheel_ratio) || config.motor_to_wheel_ratio <= 0.0 ||
        !std::isfinite(config.max_wheel_rpm) || config.max_wheel_rpm <= 0.0 ||
        !std::isfinite(config.command_timeout_ms) ||
        config.command_timeout_ms > kMaxCommandAgeMs) {
        return false;
    }
    if (config.max_wheel_rpm > 1000.0 || config.motor_to_wheel_ratio > 100.0)
        return false;

    for (int i = 0; i < 4; ++i) {
        const WheelConfig &wheel = config.wheels[i];
        if (!validPort(wheel.port))
            return false;
        if (!std::isfinite(wheel.max_current_ma) || wheel.max_current_ma <= 0.0 ||
            !std::isfinite(wheel.max_temperature_c) || wheel.max_temperature_c <= 0.0) {
            return false;
        }
        for (int j = i + 1; j < 4; ++j) {
            if (std::abs(wheel.port) == std::abs(config.wheels[j].port))
                return false;
        }
    }
    return true;
}

bool checkMeasuredLimits(const State &state) {
    for (int i = 0; i < 4; ++i) {
        const WheelState &wheel = state.wheel[i];
        const WheelConfig &config = g_config.wheels[i];
        if (!wheel.valid)
            return false;
        if (std::fabs(wheel.current_ma) > config.max_current_ma)
            return false;
        if (wheel.temperature_c > config.max_temperature_c)
            return false;
    }
    return true;
}

} // namespace

bool initialize(const Config &config, std::uint32_t now_ms) {
    if (g_bank)
        return true; // 只允许初始化一次；换端口需要重新烧录/重启
    if (!validateConfig(config)) {
        g_fault = Fault::InvalidConfig;
        return false;
    }
    for (int i = 0; i < 4; ++i) {
        for (int j = i + 1; j < 4; ++j) {
            if (std::abs(config.wheels[i].port) == std::abs(config.wheels[j].port)) {
                g_fault = Fault::PortConflict;
                return false;
            }
        }
    }

    g_config = config;
    g_bank = new (&g_storage) MotorBank(config);
    for (int i = 0; i < 4; ++i) {
        pros::Motor *motor = motorAt(i);
        if (!motor || writeFailed(motor->set_brake_mode(pros::MotorBrake::brake))) {
            setFault(Fault::WriteFailed);
            return false;
        }
    }

    g_fault = Fault::None;
    g_mode = Mode::Stopped;
    g_last_command_ms = now_ms;
    g_last_power.fill(0);
    if (config.tare_on_init && !tare_position(now_ms)) {
        setFault(Fault::WriteFailed);
        return false;
    }

    State state{};
    if (!read_state(state)) {
        if (g_fault == Fault::None)
            setFault(Fault::WriteFailed);
        return false;
    }
    return true;
}

bool set_wheel_power(int front_left, int front_right, int back_left, int back_right) {
    if (!g_bank || g_fault != Fault::None)
        return false;
    if (forbidden()) {
        stopAll();
        return false;
    }

    const int target[4] = {front_left, front_right, back_left, back_right};
    std::array<int, 4> output{};
    g_mode = Mode::Power;
    for (int i = 0; i < 4; ++i) {
        const int clamped = std::clamp(target[i], -127, 127);
        if (g_config.max_power_delta_per_update > 0) {
            const int delta = std::clamp(clamped - g_last_power[i],
                                         -g_config.max_power_delta_per_update,
                                         g_config.max_power_delta_per_update);
            output[i] = g_last_power[i] + delta;
        } else {
            output[i] = clamped;
        }
    }

    for (int i = 0; i < 4; ++i) {
        if (writeFailed(motorAt(i)->move(output[i]))) {
            setFault(Fault::WriteFailed);
            return false;
        }
    }
    g_last_power = output;
    g_last_command_ms = pros::millis();
    return true;
}

bool set_wheel_velocity(double front_left_rpm, double front_right_rpm, double back_left_rpm,
                       double back_right_rpm) {
    if (!g_bank || g_fault != Fault::None)
        return false;
    if (forbidden()) {
        stopAll();
        return false;
    }

    const double wheel_rpm[4] = {front_left_rpm, front_right_rpm, back_left_rpm, back_right_rpm};
    for (int i = 0; i < 4; ++i) {
        if (!std::isfinite(wheel_rpm[i])) {
            setFault(Fault::WriteFailed);
            return false;
        }
    }

    g_mode = Mode::Velocity;
    for (int i = 0; i < 4; ++i) {
        const double clamped = std::clamp(wheel_rpm[i], -g_config.max_wheel_rpm,
                                          g_config.max_wheel_rpm);
        const int motor_rpm = static_cast<int>(std::lround(clamped * g_config.motor_to_wheel_ratio));
        if (writeFailed(motorAt(i)->move_velocity(motor_rpm))) {
            setFault(Fault::WriteFailed);
            return false;
        }
    }
    g_last_power.fill(0);
    g_last_command_ms = pros::millis();
    return true;
}

bool read_state(State &out) {
    out = State{};
    if (!g_bank || g_fault != Fault::None)
        return false;

    out.timestamp_ms = pros::millis();
    bool all_valid = true;
    for (int i = 0; i < 4; ++i) {
        pros::Motor *motor = motorAt(i);
        WheelState &state = out.wheel[i];
        const int current = motor->get_current_draw();
        const double velocity = motor->get_actual_velocity();
        const double position = motor->get_position();
        const double temperature = motor->get_temperature();

        state.current_ma = current >= 0 ? static_cast<double>(current) : 0.0;
        state.velocity_rpm = std::isfinite(velocity) ? velocity / g_config.motor_to_wheel_ratio : 0.0;
        state.position_deg = std::isfinite(position) ? position / g_config.motor_to_wheel_ratio : 0.0;
        state.temperature_c = std::isfinite(temperature) ? temperature : 0.0;
        state.valid = current >= 0 && current != std::numeric_limits<std::int32_t>::max() &&
                      std::isfinite(velocity) && std::isfinite(position) &&
                      std::isfinite(temperature);
        all_valid = all_valid && state.valid;
    }
    out.valid = all_valid;
    if (!all_valid) {
        setFault(Fault::WriteFailed);
        return false;
    }
    if (!checkMeasuredLimits(out)) {
        for (int i = 0; i < 4; ++i) {
            if (std::fabs(out.wheel[i].current_ma) > g_config.wheels[i].max_current_ma) {
                setFault(Fault::OverCurrent);
                return false;
            }
            if (out.wheel[i].temperature_c > g_config.wheels[i].max_temperature_c) {
                setFault(Fault::OverTemperature);
                return false;
            }
        }
        setFault(Fault::WriteFailed);
        return false;
    }
    return true;
}

bool tare_position(std::uint32_t now_ms) {
    if (!g_bank || g_fault != Fault::None)
        return false;
    if (g_mode != Mode::Stopped)
        return false;

    for (int i = 0; i < 4; ++i) {
        if (writeFailed(motorAt(i)->tare_position())) {
            setFault(Fault::WriteFailed);
            return false;
        }
    }
    g_last_command_ms = now_ms;
    return true;
}

void poll(std::uint32_t now_ms) {
    if (!g_bank || g_fault != Fault::None)
        return;

    if ((g_mode == Mode::Power || g_mode == Mode::Velocity) &&
        g_config.command_timeout_ms > 0 &&
        static_cast<std::int32_t>(now_ms - g_last_command_ms) >
            static_cast<std::int32_t>(g_config.command_timeout_ms)) {
        setFault(Fault::StaleCommand);
        return;
    }

    State state{};
    (void)read_state(state);
}

bool clearFault(std::uint32_t now_ms) {
    if (!g_bank || g_fault == Fault::None)
        return false;
    stopAll();
    g_fault = Fault::None;
    g_last_command_ms = now_ms;
    State state{};
    return read_state(state);
}

void stop() {
    stopAll();
}

bool isHealthy() {
    return g_bank != nullptr && g_fault == Fault::None && g_mode != Mode::Fault;
}

Fault getFault() {
    return g_fault;
}

const char *faultName(Fault fault) {
    switch (fault) {
    case Fault::None:
        return "OK";
    case Fault::NotInitialized:
        return "NOT INITIALIZED";
    case Fault::InvalidConfig:
        return "INVALID CONFIG";
    case Fault::PortConflict:
        return "PORT CONFLICT";
    case Fault::WriteFailed:
        return "WRITE FAILED";
    case Fault::OverCurrent:
        return "OVER CURRENT";
    case Fault::OverTemperature:
        return "OVER TEMPERATURE";
    case Fault::StaleCommand:
        return "STALE COMMAND";
    }
    return "UNKNOWN";
}

Mode getMode() {
    return g_mode;
}

} // namespace chassis
