{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "PROS: Build",
      "type": "process",
      "command": "${env:HOME}/.local/bin/pros",
      "args": [
        "build"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "${env:HOME}/.local/share/uv/tools/pros-cli/bin:${env:HOME}/.local/bin:/usr/bin:${env:HOME}/.config/Code/User/globalStorage/sigbots.pros/install/vex-vexcom-linux:${env:PATH}",
          "PROS_TOOLCHAIN": "/usr"
        }
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "PROS: Rebuild",
      "type": "process",
      "command": "${env:HOME}/.local/bin/pros",
      "args": [
        "build",
        "all"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "${env:HOME}/.local/share/uv/tools/pros-cli/bin:${env:HOME}/.local/bin:/usr/bin:${env:HOME}/.config/Code/User/globalStorage/sigbots.pros/install/vex-vexcom-linux:${env:PATH}",
          "PROS_TOOLCHAIN": "/usr"
        }
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "PROS: Update compile_commands",
      "type": "process",
      "command": "${env:HOME}/.local/bin/pros",
      "args": [
        "build-compile-commands",
        "clean",
        "quick"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "${env:HOME}/.local/share/uv/tools/pros-cli/bin:${env:HOME}/.local/bin:/usr/bin:${env:HOME}/.config/Code/User/globalStorage/sigbots.pros/install/vex-vexcom-linux:${env:PATH}",
          "PROS_TOOLCHAIN": "/usr"
        }
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "PROS: Upload",
      "type": "process",
      "command": "${env:HOME}/.local/bin/pros",
      "args": [
        "upload"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "${env:HOME}/.local/share/uv/tools/pros-cli/bin:${env:HOME}/.local/bin:/usr/bin:${env:HOME}/.config/Code/User/globalStorage/sigbots.pros/install/vex-vexcom-linux:${env:PATH}",
          "PROS_TOOLCHAIN": "/usr"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "PROS: Terminal",
      "type": "process",
      "command": "${env:HOME}/.local/bin/pros",
      "args": [
        "terminal"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "PATH": "${env:HOME}/.local/share/uv/tools/pros-cli/bin:${env:HOME}/.local/bin:/usr/bin:${env:HOME}/.config/Code/User/globalStorage/sigbots.pros/install/vex-vexcom-linux:${env:PATH}",
          "PROS_TOOLCHAIN": "/usr"
        }
      },
      "problemMatcher": []
    },
    {
      "label": "PROS: Build & Upload",
      "dependsOrder": "sequence",
      "dependsOn": [
        "PROS: Build",
        "PROS: Upload"
      ],
      "problemMatcher": []
    }
  ]
}
