{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "PROS: Check sources",
      "type": "process",
      "command": "python",
      "args": [
        "${workspaceFolder}/tools/configure_env.py",
        "--check"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "PROS: Build",
      "type": "process",
      "command": "make",
      "args": [
        "-j4"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "label": "PROS: Rebuild",
      "type": "process",
      "command": "make",
      "args": [
        "all",
        "-j4"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "PROS: Clean",
      "type": "process",
      "command": "make",
      "args": [
        "clean"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "PROS: Update compile_commands",
      "type": "process",
      "command": "python",
      "args": [
        "${workspaceFolder}/tools/configure_env.py"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "PROS: Upload",
      "type": "process",
      "command": "pros",
      "args": [
        "upload"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "PROS: Terminal",
      "type": "process",
      "command": "pros",
      "args": [
        "terminal"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "PROS: Build & Upload",
      "dependsOrder": "sequence",
      "dependsOn": [
        "PROS: Build",
        "PROS: Upload"
      ],
      "problemMatcher": []
    },
    {
      "label": "CMake: Configure (host)",
      "type": "process",
      "command": "cmake",
      "args": [
        "--preset",
        "host-debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    },
    {
      "label": "CMake: Build (host)",
      "type": "process",
      "command": "cmake",
      "args": [
        "--build",
        "--preset",
        "host-debug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": [
        "$gcc"
      ]
    },
    {
      "label": "CMake: Test (host)",
      "type": "process",
      "command": "ctest",
      "args": [
        "--preset",
        "host-debug",
        "--output-on-failure"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "problemMatcher": []
    }
  ]
}
